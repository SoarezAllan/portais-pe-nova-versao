// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String            @id @default(cuid())
  name                    String            @default("")
  email                   String            @unique @default("")
  password                String
  role                    String?           @default("operator")
  resetCode               String            @default("")
  passwordResetToken      String?
  passwordResetIssuedAt   DateTime?
  passwordResetRedeemedAt DateTime?
  createdAt               DateTime?
  noticias                Noticia[]         @relation("Noticia_autor")
  areas                   AreaResponsavel[] @relation("User_areas")
}

model AuditLog {
  id         String    @id @default(cuid())
  dataAcao   DateTime? @default(now())
  usuario    String    @default("")
  operacao   String?
  tabela     String    @default("")
  itemId     String    @default("")
  itemTitulo String    @default("")
  mudancas   String    @default("")

  @@map("AuditLogs")
}

model Servico {
  id                String           @id @default(cuid())
  titulo            String           @default("")
  slug              String           @unique @default("")
  imagem_id         String?
  imagem_filesize   Int?
  imagem_width      Int?
  imagem_height     Int?
  imagem_extension  String?
  imagemAlt         String           @default("")
  resumo            String           @default("")
  oQueE             Json             @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  quemPrecisa       Json             @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  comoSolicitar     Json             @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  maisInformacoes   Json             @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  areaResponsavel   AreaResponsavel? @relation("Servico_areaResponsavel", fields: [areaResponsavelId], references: [id])
  areaResponsavelId String?          @map("areaResponsavel")
  subarea           Subarea?         @relation("Servico_subarea", fields: [subareaId], references: [id])
  subareaId         String?          @map("subarea")
  ativo             Boolean          @default(true)
  createdAt         DateTime?
  createdBy         String           @default("")
  updatedAt         DateTime?
  updatedBy         String           @default("")
  deletedAt         DateTime?
  deletedBy         String           @default("")

  @@index([areaResponsavelId])
  @@index([subareaId])
  @@map("Servicos")
}

model Solucao {
  id                String           @id @default(cuid())
  titulo            String           @default("")
  slug              String           @unique @default("")
  categoria         String
  imagem_id         String?
  imagem_filesize   Int?
  imagem_width      Int?
  imagem_height     Int?
  imagem_extension  String?
  imagemAlt         String           @default("")
  resumo            String           @default("")
  corpo             Json             @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  linkExterno       String           @default("")
  areaResponsavel   AreaResponsavel? @relation("Solucao_areaResponsavel", fields: [areaResponsavelId], references: [id])
  areaResponsavelId String?          @map("areaResponsavel")
  subarea           Subarea?         @relation("Solucao_subarea", fields: [subareaId], references: [id])
  subareaId         String?          @map("subarea")
  ativo             Boolean          @default(true)
  createdAt         DateTime?
  createdBy         String           @default("")
  updatedAt         DateTime?
  updatedBy         String           @default("")

  @@index([areaResponsavelId])
  @@index([subareaId])
  @@map("Solucoes")
}

model Noticia {
  id                        String           @id @default(cuid())
  titulo                    String           @default("")
  subtitulo                 String           @default("")
  autor                     User?            @relation("Noticia_autor", fields: [autorId], references: [id])
  autorId                   String?          @map("autor")
  areaResponsavel           AreaResponsavel? @relation("Noticia_areaResponsavel", fields: [areaResponsavelId], references: [id])
  areaResponsavelId         String?          @map("areaResponsavel")
  subarea                   Subarea?         @relation("Noticia_subarea", fields: [subareaId], references: [id])
  subareaId                 String?          @map("subarea")
  ativo                     Boolean          @default(true)
  createdAt                 DateTime?
  createdBy                 String           @default("")
  dataPublicacao            DateTime         @default(now())
  imagemPrincipal_id        String?
  imagemPrincipal_filesize  Int?
  imagemPrincipal_width     Int?
  imagemPrincipal_height    Int?
  imagemPrincipal_extension String?
  imagemPrincipalAlt        String           @default("")
  corpo                     Json             @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  tags                      Tag[]            @relation("Noticia_tags")
  destaque                  Boolean          @default(false)
  resumo                    String           @default("")
  slug                      String           @unique @default("")

  @@index([autorId])
  @@index([areaResponsavelId])
  @@index([subareaId])
}

model Legislacao {
  id                String           @id @default(cuid())
  titulo            String           @default("")
  linkExterno       String           @default("")
  categoria         String
  areaResponsavel   AreaResponsavel? @relation("Legislacao_areaResponsavel", fields: [areaResponsavelId], references: [id])
  areaResponsavelId String?          @map("areaResponsavel")
  subarea           Subarea?         @relation("Legislacao_subarea", fields: [subareaId], references: [id])
  subareaId         String?          @map("subarea")
  resumo            String           @default("")
  createdAt         DateTime?
  createdBy         String           @default("")
  updatedAt         DateTime?
  updatedBy         String           @default("")

  @@index([areaResponsavelId])
  @@index([subareaId])
  @@map("Legislacoes")
}

model Curso {
  id                String           @id @default(cuid())
  titulo            String           @default("")
  status            String           @default("PROGRAMADO")
  resumo            String           @default("")
  linkExterno       String           @default("")
  dataDoCurso       DateTime         @default(now())
  areaResponsavel   AreaResponsavel? @relation("Curso_areaResponsavel", fields: [areaResponsavelId], references: [id])
  areaResponsavelId String?          @map("areaResponsavel")
  subarea           Subarea?         @relation("Curso_subarea", fields: [subareaId], references: [id])
  subareaId         String?          @map("subarea")
  modalidade        String           @default("PRESENCIAL")
  local             String           @default("")
  createdAt         DateTime?
  createdBy         String           @default("")
  updatedAt         DateTime?
  updatedBy         String           @default("")

  @@index([areaResponsavelId])
  @@index([subareaId])
  @@map("Cursos")
}

model Tag {
  id                String           @id @default(cuid())
  nome              String           @unique @default("")
  areaResponsavel   AreaResponsavel? @relation("Tag_areaResponsavel", fields: [areaResponsavelId], references: [id])
  areaResponsavelId String?          @map("areaResponsavel")
  subarea           Subarea?         @relation("Tag_subarea", fields: [subareaId], references: [id])
  subareaId         String?          @map("subarea")
  noticias          Noticia[]        @relation("Noticia_tags")

  @@index([areaResponsavelId])
  @@index([subareaId])
}

model AreaResponsavel {
  id                             String            @id @default(cuid())
  nome                           String            @default("")
  subareas                       Subarea[]         @relation("Subarea_area")
  gerencias                      Gerencia[]        @relation("Gerencia_area")
  servicos                       Servico[]         @relation("Servico_areaResponsavel")
  cursos                         Curso[]           @relation("Curso_areaResponsavel")
  solucoes                       Solucao[]         @relation("Solucao_areaResponsavel")
  noticias                       Noticia[]         @relation("Noticia_areaResponsavel")
  tags                           Tag[]             @relation("Tag_areaResponsavel")
  legislacoes                    Legislacao[]      @relation("Legislacao_areaResponsavel")
  gestores                       Gestores[]        @relation("Gestores_areaResponsavel")
  paginasQuemSomos               PaginaQuemSomos[] @relation("PaginaQuemSomos_areaResponsavel")
  createdAt                      DateTime?
  createdBy                      String            @default("")
  updatedAt                      DateTime?
  updatedBy                      String            @default("")
  deletedAt                      DateTime?
  deletedBy                      String            @default("")
  from_User_areas                User[]            @relation("User_areas")
  from_Portfolio_areaResponsavel Portfolio[]       @relation("Portfolio_areaResponsavel")

  @@map("AreasResponsaveis")
}

model Gerencia {
  id          String           @id @default(cuid())
  nome        String           @default("")
  responsavel String           @default("")
  telefone1   String           @default("")
  telefone2   String           @default("")
  email       String           @default("")
  area        AreaResponsavel? @relation("Gerencia_area", fields: [areaId], references: [id])
  areaId      String?          @map("area")
  setores     Setor[]          @relation("Setor_gerencia")
  createdAt   DateTime?
  createdBy   String           @default("")
  updatedAt   DateTime?
  updatedBy   String           @default("")

  @@index([areaId])
  @@map("Gerencias")
}

model Setor {
  id         String    @id @default(cuid())
  nome       String    @default("")
  gerencia   Gerencia? @relation("Setor_gerencia", fields: [gerenciaId], references: [id])
  gerenciaId String?   @map("gerencia")
  createdAt  DateTime?
  createdBy  String    @default("")
  updatedAt  DateTime?
  updatedBy  String    @default("")

  @@index([gerenciaId])
  @@map("Setores")
}

model Subarea {
  id                                String                 @id @default(cuid())
  nome                              String                 @default("")
  area                              AreaResponsavel?       @relation("Subarea_area", fields: [areaId], references: [id])
  areaId                            String?                @map("area")
  servicos                          Servico[]              @relation("Servico_subarea")
  cursos                            Curso[]                @relation("Curso_subarea")
  noticias                          Noticia[]              @relation("Noticia_subarea")
  legislacoes                       Legislacao[]           @relation("Legislacao_subarea")
  solucoes                          Solucao[]              @relation("Solucao_subarea")
  tags                              Tag[]                  @relation("Tag_subarea")
  createdAt                         DateTime?
  createdBy                         String                 @default("")
  updatedAt                         DateTime?
  updatedBy                         String                 @default("")
  from_PaginaQuemSomos_subarea      PaginaQuemSomos[]      @relation("PaginaQuemSomos_subarea")
  from_QuemSomosSubareaItem_subarea QuemSomosSubareaItem[] @relation("QuemSomosSubareaItem_subarea")
  from_Portfolio_subarea            Portfolio[]            @relation("Portfolio_subarea")

  @@index([areaId])
  @@map("Subareas")
}

model Gestores {
  id                String           @id @default(cuid())
  nome              String           @default("")
  cargo             String           @default("")
  descricao         String           @default("")
  foto_id           String?
  foto_filesize     Int?
  foto_width        Int?
  foto_height       Int?
  foto_extension    String?
  areaResponsavel   AreaResponsavel? @relation("Gestores_areaResponsavel", fields: [areaResponsavelId], references: [id])
