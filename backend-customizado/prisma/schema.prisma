  @@index([areaResponsavelId])
}

model PaginaQuemSomos {
  id                     String                 @id @default(cuid())
  tituloDaPagina         String                 @default("Quem Somos")
  muralTextoIntrodutorio String                 @default("")
  timeTitulo             String                 @default("Nosso Time")
  timeDescricao          String                 @default("")
  muralItens             QuemSomosMuralItem[]   @relation("QuemSomosMuralItem_pagina")
  conteudosPorSubarea    QuemSomosSubareaItem[] @relation("QuemSomosSubareaItem_pagina")
  time                   QuemSomosTimeItem[]    @relation("QuemSomosTimeItem_pagina")
  areaResponsavel        AreaResponsavel?       @relation("PaginaQuemSomos_areaResponsavel", fields: [areaResponsavelId], references: [id])
  areaResponsavelId      String?                @map("areaResponsavel")
