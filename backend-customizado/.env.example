# URL de conexão com o PostgreSQL (mesma do Keystone)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portaispe

# Segredo para assinar o cookie de sessão (substitua em produção)
SESSION_SECRET=uma-chave-secreta-muito-longa-e-segura

# Idade máxima da sessão em segundos (30 dias)
SESSION_MAX_AGE=2592000

# Porta do servidor (deve ser 3001)
PORT=3001

# URL pública do backend (para links de reset, URLs de imagens)
BACKEND_URL=http://localhost:3001

# URL de frontend para CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
</content>

