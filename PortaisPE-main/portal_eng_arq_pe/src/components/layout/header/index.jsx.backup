import React, { useEffect, useState } from "react";
import { Link, useLocation } from "react-router-dom";
import "./style.css";

import LogoGovPe from "/src/assets/images/Logo_gov.png";
import siteConfig from "../../../config/siteConfig";

function normalizeId(label) {
  return label
    .toLowerCase()
    .replace(/[^a-z0-9\s]/g, "")
    .trim()
    .replace(/\s+/g, "_");
}

const Header = () => {
  const location = useLocation();
  const [menuOpen, setMenuOpen] = useState(false);
  const [openDropdown, setOpenDropdown] = useState(null);

  useEffect(() => {
    setMenuOpen(false);
    setOpenDropdown(null);
  }, [location.pathname, location.hash]);

  const toggleDropdown = (name, e) => {
    if (window.innerWidth <= 1024) {
      e.preventDefault();
      setOpenDropdown(openDropdown === name ? null : name);
    }
  };

  return (
    <header className="header">
      <div className="header-container">
        <div className="header-content">

          <Link
  to="/"
  className="logo-area"
  aria-label={siteConfig.SITE_TITLE}
>
  <div className="logo-container">
    <h1 className="site-title">
      {siteConfig.SITE_TITLE}
    </h1>
  </div>
</Link>

          {/* MENU TOGGLE MOBILE */}
          <button
            className="menu-toggle"
            onClick={() => setMenuOpen(!menuOpen)}
            aria-label="Menu"
          >
            <img
              src="/icons/hamburguer.png"
              alt="Menu"
              className="hamburger-img"
            />
          </button>

          {/* NAV DESKTOP */}
          <nav className="nav-container">
            <ul className="nav-links">

              <li>
                <Link to="/">Início</Link>
              </li>

              <li>
                <Link to="/quem-somos">Quem somos</Link>
              </li>

              <li>
                <Link to="/materias">Notícias</Link>
              </li>

              {/* SERVIÇOS */}
              <li className="dropdown">
                <Link to="/servicos">
                  Serviços <span className="arrow">▾</span>
                </Link>

                <ul className="dropdown-menu">
                  {siteConfig.SUBAREAS.map((s) => (
                    <li key={s}>
                      <Link to={`/servicos#categoria-${normalizeId(s)}`}>
                        {s}
                      </Link>
                    </li>
                  ))}
                </ul>
              </li>

              {/* PORTFÓLIO (SUBSTITUI SOLUÇÕES) */}
              <li className="dropdown">
                <Link to="/portifolio">
                  Portfólio <span className="arrow">▾</span>
                </Link>

                <ul className="dropdown-menu">
                  {siteConfig.SUBAREAS.map((s) => (
                    <li key={s}>
                      <Link to={`/portifolio#categoria-${normalizeId(s)}`}>
                        {s}
                      </Link>
                    </li>
                  ))}
                </ul>
              </li>

              {/* LEGISLAÇÃO */}
              <li className="dropdown">
                <Link to="/legislacao">
                  Legislação <span className="arrow">▾</span>
                </Link>

                <ul className="dropdown-menu">
                  {siteConfig.SUBAREAS.map((s) => (
                    <li key={s}>
                      <Link to={`/legislacao#area-${normalizeId(s)}`}>
                        {s}
                      </Link>
                    </li>
                  ))}
                </ul>
              </li>

            </ul>
          </nav>
        </div>
      </div>

      {/* OVERLAY MOBILE */}
      <div
        className={`mobile-overlay ${menuOpen ? "active" : ""}`}
        onClick={() => setMenuOpen(false)}
      />

      {/* MENU MOBILE */}
      <nav className={`mobile-menu ${menuOpen ? "active" : ""}`}>
        <ul>

          {/* LINKS SIMPLES */}
          {["Início", "Quem somos", "Notícias", "Cursos"].map((item) => (
            <li key={item}>
              <Link
                to={`/${
                  item === "Início"
                    ? ""
                    : item.toLowerCase().replace(" ", "-")
                }`}
              >
                {item}
              </Link>
            </li>
          ))}

          {/* MENUS DROPDOWN MOBILE */}
          {[
            {
              name: "Serviços",
              key: "servicos",
              links: siteConfig.SUBAREAS.map((s) => [
                s,
                `/servicos#categoria-${normalizeId(s)}`,
              ]),
            },

            {
              name: "Portfólio",
              key: "portfolio",
              links: siteConfig.SUBAREAS.map((s) => [
                s,
                `/portifolio#categoria-${normalizeId(s)}`,
              ]),
            },

            {
              name: "Legislação",
              key: "legislacao",
              links: siteConfig.SUBAREAS.map((s) => [
                s,
                `/legislacao#area-${normalizeId(s)}`,
              ]),
            },
          ].map((section) => (
            <li
              key={section.key}
              className={`has-sub ${
                openDropdown === section.key ? "open" : ""
              }`}
            >
              <a href="#" onClick={(e) => toggleDropdown(section.key, e)}>
                {section.name} <span>▾</span>
              </a>

              <ul>
                {section.links.map(([label, path]) => (
                  <li key={label}>
                    <Link to={path}>{label}</Link>
                  </li>
                ))}
              </ul>
            </li>
          ))}

        </ul>
      </nav>
    </header>
  );
};

export default Header;